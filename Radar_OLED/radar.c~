    }
}
void DrawRadarPoint(int distance, int angle) {
    float max_range = 100.0;           // Max sensor range
    float scale = 60.0 / max_range;    // Max radius on screen
    float rad = angle * 3.14159 / 180.0;
    int x = 64 + (int)(distance * scale * cos(rad));
    int y = 63 - (int)(distance * scale * sin(rad));

    OLED_Pixel(x, y);
}
/* Servo */
void servo_init(void)
{
    DDRD |= (1<<5);      // OC1A as output

    // Timer1 Fast PWM, Mode 14 (ICR1 TOP)
    TCCR1A = (1<<COM1A1) | (1<<WGM11);
    TCCR1B = (1<<WGM13) | (1<<WGM12) | (1<<CS11);

    // F_CPU = 8MHz
    // Prescaler = 8
    // Timer frequency = 1MHz
    // 1 count = 1 us

    ICR1H = (20000 >> 8);
    ICR1L = (unsigned char)20000;          // 20 ms period (50 Hz)

    OCR1A = 1500;          // Start at 90°
}

// Move Servo to Angle (0-180)
void servo_write(unsigned char angle)
{
    unsigned int pulse;

    if(angle > 180)
        angle = 180;

    // Convert angle to pulse width
    // 1000 us -> 2000 us
    pulse = 1000 + ((unsigned long)angle * 1000) / 180;

    OCR1A = pulse;
}




